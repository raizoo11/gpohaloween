-- ================= Core Logic =================
local function getBuildingFolder()
    local folder = workspace
    for _, name in ipairs(BUILDING_PATH) do
        folder = folder:FindFirstChild(name)
        if not folder then return nil end
    end
    return folder
end

local function getDoorPosition(door)
    if door:IsA("BasePart") then
        return door.Position
    elseif door:IsA("Model") then
        if door.PrimaryPart then
            return door.PrimaryPart.Position
        end
        local part = door:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position end
    else
        -- Accessory / Folder / instance lain: ambil BasePart pertama di dalamnya
        local part = door:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position end
    end
    return nil
end

local function getAllEventDoors()
    local building = getBuildingFolder()
    if not building then return {} end

    local doors = {}
    for index, child in ipairs(building:GetChildren()) do
        local door = child:FindFirstChild(EVENT_DOOR_CHILD_NAME)
        if door then
            if IGNORED_DOOR_INDEXES[index] or IGNORED_DOOR_NAMES[child.Name] then
                -- Door di-ignore: print sekali biar kelihatan yang mana yang ke-skip
                if not IgnoredDoorPrinted[child] then
                    IgnoredDoorPrinted[child] = true
                    print("[AutoEventDoor] Ignore door #" .. index .. " (" .. child:GetFullName() .. ")")
                end
            else
                table.insert(doors, door)
            end
        end
    end

    LastKnownDoorCount = #doors -- simpen buat progress label "Opened: x/total"
    return doors
end

-- Pilih door berikutnya:
--  1) Door yang SUDAH SIAP (belum pernah dikunjungi / cooldown udah abis):
--     yang terdekat dalam SearchRadius dulu, kalau gak ada yang terdekat tanpa batas radius.
--  2) Kalau SEMUA door masih cooldown: pilih door yang cooldown-nya paling duluan abis.
--     Itu door yang paling dulu dikunjungi (= "balik ke door pertama"). Caller
--     jalan ke sana lalu nunggu sampai siap.
local function findNextEventDoor()
    local doors = getAllEventDoors()
    local originPos = RootPart.Position
    local now = tick()

    local nearestInRadius, nearestInRadiusDist = nil, math.huge
    local nearestAny, nearestAnyDist = nil, math.huge

    for _, door in ipairs(doors) do
        if now >= getDoorReadyAt(door) then
            local pos = getDoorPosition(door)
            if pos then
                local dist = (pos - originPos).Magnitude
                if dist <= Settings.SearchRadius and dist < nearestInRadiusDist then
                    nearestInRadius = door
                    nearestInRadiusDist = dist
                end
                if dist < nearestAnyDist then
                    nearestAny = door
                    nearestAnyDist = dist
                end
            end
        end
    end

    if nearestInRadius then return nearestInRadius end
    if nearestAny then return nearestAny end

    -- Semua door lagi cooldown: ambil yang paling cepat siap
    local soonest, soonestAt = nil, math.huge
    for _, door in ipairs(doors) do
        if getDoorPosition(door) then
            local readyAt = getDoorReadyAt(door)
            if readyAt < soonestAt then
                soonest = door
                soonestAt = readyAt
            end
        end
    end

    return soonest
end

-- ============ Deteksi STUN ============
-- LocalPlayer.StunFolder.Stun aktif pas karakter lagi kena stun (animasi ambil
-- candy, diculik, dll). Dipakai buat nunggu animasi selesai di ANTARA aksi
-- (mis. abis fire prompt door). TWEEN gak ikut berhenti kena stun/hit.
-- Tipe instance "Stun" belum pasti, jadi dicek fleksibel:
--   Bool -> true = stun | Number/Int -> > 0 | String -> gak kosong |
--   Folder/Configuration -> punya child | tipe lain -> ada = stun
local STUN_MAX_WAIT = 25 -- detik, batas nunggu stun (pengaman kalau deteksi salah)
local StunDebugPrinted = false

local function isStunned()
    local folder = LocalPlayer:FindFirstChild("StunFolder")
    local stun = folder and folder:FindFirstChild("Stun")
    if not stun then return false end

    if not StunDebugPrinted then
        StunDebugPrinted = true
        print("[AutoEventDoor] StunFolder.Stun ketemu, tipe: " .. stun.ClassName)
    end

    if stun:IsA("BoolValue") then return stun.Value end
    if stun:IsA("NumberValue") or stun:IsA("IntValue") then return stun.Value > 0 end
    if stun:IsA("StringValue") then return stun.Value ~= "" end
    if stun:IsA("ValueBase") then return stun.Value ~= nil end
    if stun:IsA("Folder") or stun:IsA("Configuration") then
        return #stun:GetChildren() > 0
    end
    return true
end

-- Tunggu sampai stun habis. Return: true kalau tadi sempat stun
local function waitUntilNotStunned()
    if not isStunned() then return false end

    local start = tick()
    while Enabled and isStunned() do
        StatusExtra = string.format("stun %.1fs", tick() - start)
        updateGuiState()

        if tick() - start >= STUN_MAX_WAIT then
            print("[AutoEventDoor] Stun lebih dari " .. STUN_MAX_WAIT .. " detik, lanjut paksa.")
            break
        end
        task.wait(0.1)
    end

    StatusExtra = ""
    updateGuiState()
    task.wait(0.15) -- jeda kecil biar kontrol karakter balik normal
    return true
end

-- ============ Trigger ProximityPrompt event door ============
-- Target: <door>.Frame.ProximityPrompt
-- (door = workspace.Islands.Spooksville.Building:GetChildren()[i].eventDoor)

local function getDoorPrompt(door)
    local frame = door and door:FindFirstChild("Frame")
    if not frame then return nil end

    local prompt = frame:FindFirstChild("ProximityPrompt")
    if prompt and prompt:IsA("ProximityPrompt") then
        return prompt
    end

    -- Jaga-jaga kalau prompt-nya ada di dalam child lain di Frame
    return frame:FindFirstChildWhichIsA("ProximityPrompt", true)
end

-- Fallback kalau executor gak punya fireproximityprompt: tap E manual
local function tapKeyE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    task.wait(0.05)
end

-- Aktifin prompt event door berulang-ulang selama `duration` detik.
-- Return: true kalau prompt ketemu & dipicu minimal sekali
local function triggerDoorPrompt(door, duration)
    local prompt = getDoorPrompt(door)
    if not prompt then
        print("[AutoEventDoor] ProximityPrompt gak ketemu di eventDoor.Frame, fallback ke tombol E.")
        local startTime = tick()
        while Enabled and (tick() - startTime) < duration do
            tapKeyE()
        end
        return false
    end

    -- Kalau lagi stun (mis. sisa animasi sebelumnya), tunggu dulu
    waitUntilNotStunned()

    local startTime = tick()
    local fired = false

    while Enabled and prompt.Parent and (tick() - startTime) < duration do
        if typeof(fireproximityprompt) == "function" then
            -- Langsung trigger prompt, gak perlu tahan E & gak peduli jarak/hold duration
            local ok = pcall(fireproximityprompt, prompt)
            fired = fired or ok
            task.wait(0.1)
        else
            -- Executor gak support: pakai API bawaan Roblox (hold sesuai HoldDuration prompt)
            local ok = pcall(function()
                prompt:InputHoldBegin()
                task.wait(math.max(prompt.HoldDuration, 0.05) + 0.05)
                prompt:InputHoldEnd()
            end)
            fired = fired or ok
            if not ok then
                tapKeyE()
            end
        end

        -- Stun mulai setelah fire = prompt sudah kena (animasi ambil candy /
        -- diculik). Berhenti spam, caller yang nunggu stun habis.
        if fired and isStunned() then
            break
        end
    end

    return fired
end

-- ============ HOLD WASD MOVEMENT (camera-relative, tanpa sentuh kamera) ============
-- W/A/S/D di Roblox itu arahnya RELATIF KE KAMERA, bukan ke badan. Jadi di sini
-- kita CUMA BACA arah kamera saat ini (gak pernah ditulis/diputer sama sekali -
-- makanya gak ada potensi konflik/muter-muter), terus tentuin kombinasi tombol
-- yang bikin karakter jalan ke arah target. Humanoid.AutoRotate dibiarin true
-- (default), jadi badan muter sendiri secara natural ngikut arah gerak, persis
-- kayak kalau pemain beneran mencet WASD.

local HeldKeys = {
    [Enum.KeyCode.W] = false,
    [Enum.KeyCode.A] = false,
    [Enum.KeyCode.S] = false,
    [Enum.KeyCode.D] = false,
}

local function setKeyHeld(keyCode, shouldHold)
    if HeldKeys[keyCode] == shouldHold then return end
    HeldKeys[keyCode] = shouldHold
    VirtualInputManager:SendKeyEvent(shouldHold, keyCode, false, game)
end

local function releaseAllMoveKeys()
    for key in pairs(HeldKeys) do
        setKeyHeld(key, false)
    end
end

-- ============ Deteksi halangan di depan (whisker raycast) ============
-- Nembak 3 ray (tengah, kiri-serong, kanan-serong) ke arah gerak buat "ngelihat"
-- ada tembok/halangan atau enggak SEBELUM nabrak, bukan nunggu sampe beneran stuck.
-- Diperpendek dari 6 - raycast jarak jauh bikin dia "nyimpang" dari waypoint yang
-- sebenernya udah bener dari PathfindingService, cuma gara-gara ada obstacle kecil
-- yang sebenernya bukan masalah (karakter emang harus lewat situ sesuai rute).
-- Sekarang cuma aktif kalau beneran udah deket mau nabrak.
local AVOID_RAY_LENGTH = 3
local AVOID_SIDE_ANGLE = 35 -- derajat, buat whisker kiri/kanan

local function getAvoidRaycastParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Character}
    params.IgnoreWater = true
    return params
end

-- Return: steered direction (Vector3, flat/world, udah di-unit-kan) yang udah
-- disesuaikan buat ngehindarin halangan, atau direction asli kalau depan aman.
local function getSteeredDirection(flatDir)
    local params = getAvoidRaycastParams()
    -- Mundurin titik awal ray sedikit (0.5 stud ke arah berlawanan) - ini penting
    -- karena kalau badan lagi NEMPEL ke tembok (misal abis mencet E deket pintu),
    -- origin ray bisa ketanam DI DALAM part itu. Roblox gak bisa deteksi hit kalau
    -- ray mulai dari dalam geometry, jadi raycast-nya jadi "buta" di situ.
    -- Mundurin dikit bikin origin-nya balik ke luar part, raycast jadi valid lagi.
    local origin = RootPart.Position + Vector3.new(0, 1, 0) - (flatDir * 0.5)

    local centerResult = workspace:Raycast(origin, flatDir * AVOID_RAY_LENGTH, params)
    if not centerResult then
        return flatDir -- depan aman, jalan lurus aja
    end

    -- Depan ke-halangin, cek whisker kiri & kanan buat nyari sisi yang kosong
    local leftDir = (CFrame.Angles(0, math.rad(AVOID_SIDE_ANGLE), 0) * flatDir)
    local rightDir = (CFrame.Angles(0, -math.rad(AVOID_SIDE_ANGLE), 0) * flatDir)

    local leftResult = workspace:Raycast(origin, leftDir * AVOID_RAY_LENGTH, params)
    local rightResult = workspace:Raycast(origin, rightDir * AVOID_RAY_LENGTH, params)

    local leftClear = leftResult == nil
    local rightClear = rightResult == nil

    if leftClear and not rightClear then
        return leftDir.Unit
    elseif rightClear and not leftClear then
        return rightDir.Unit
    elseif leftClear and rightClear then
        -- Dua-duanya kosong, default ke kanan
        return rightDir.Unit
    else
        -- Dua-duanya ke-halangin juga, pakai yang jarak hit-nya paling jauh (paling longgar)
        local leftDist = leftResult and (leftResult.Position - origin).Magnitude or 0
        local rightDist = rightResult and (rightResult.Position - origin).Magnitude or 0
        if leftDist > rightDist then
            return leftDir.Unit
        else
            return rightDir.Unit
        end
    end
end

-- Tentukan kombinasi W/A/S/D berdasarkan arah kamera SAAT INI (read-only)
-- relatif ke targetPos, dengan penghindaran halangan otomatis lewat raycast.
-- objectSpace.Z negatif = depan kamera, positif = belakang.
-- objectSpace.X positif = kanan kamera, negatif = kiri.
local function updateMoveKeysTowards(targetPos)
    local camera = workspace.CurrentCamera
    if not camera then
        releaseAllMoveKeys()
        return
    end

    local origin = RootPart.Position
    local flatDir = Vector3.new(targetPos.X - origin.X, 0, targetPos.Z - origin.Z)

    if flatDir.Magnitude < 0.1 then
        releaseAllMoveKeys()
        return
    end
    flatDir = flatDir.Unit

    -- Cek halangan di depan, steer kalau perlu
    local success, steeredDir = pcall(getSteeredDirection, flatDir)
    if success and steeredDir then
        flatDir = steeredDir
    end

    local objectSpace = camera.CFrame:VectorToObjectSpace(flatDir)

    setKeyHeld(Enum.KeyCode.W, objectSpace.Z < -0.15)
    setKeyHeld(Enum.KeyCode.S, objectSpace.Z > 0.15)
    setKeyHeld(Enum.KeyCode.D, objectSpace.X > 0.15)
    setKeyHeld(Enum.KeyCode.A, objectSpace.X < -0.15)
end

local function enableMovementMode()
    -- Gak perlu setup apa-apa; AutoRotate dibiarkan default (true)
end

local function disableMovementMode()
    releaseAllMoveKeys()
end

-- ============ Indikator arah (visual aja, biar keliatan dia niat ke mana) ============
local IndicatorBeam
do
    local originPart = Instance.new("Part")
    originPart.Name = "AutoEventDoorIndicatorOrigin"
    originPart.Size = Vector3.new(0.2, 0.2, 0.2)
    originPart.Transparency = 1
    originPart.CanCollide = false
    originPart.Anchored = false
    originPart.Massless = true
    originPart.CFrame = RootPart.CFrame
    originPart.Parent = Character

    -- Gak pakai WeldConstraint biar gak ada risiko ganggu physics/joint karakter -
    -- posisinya cukup di-update manual tiap frame (cuma buat visual doang)
    RunService.Heartbeat:Connect(function()
        if RootPart and RootPart.Parent then
            originPart.CFrame = RootPart.CFrame
        end
    end)

    local targetPart = Instance.new("Part")
    targetPart.Name = "AutoEventDoorIndicatorTarget"
    targetPart.Size = Vector3.new(0.2, 0.2, 0.2)
    targetPart.Transparency = 1
    targetPart.CanCollide = false
    targetPart.Anchored = true
    targetPart.Parent = workspace

    local att0 = Instance.new("Attachment", originPart)
    local att1 = Instance.new("Attachment", targetPart)

    local beam = Instance.new("Beam")
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.Width0 = 0.3
    beam.Width1 = 0.3
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 0))
    beam.Transparency = NumberSequence.new(0.3)
    beam.FaceCamera = true
    beam.Enabled = false
    beam.Parent = originPart

    IndicatorBeam = {
        beam = beam,
        targetPart = targetPart,
    }
end

local function showDirectionIndicator(targetPos)
    IndicatorBeam.targetPart.Position = targetPos
    IndicatorBeam.beam.Enabled = true
end

local function hideDirectionIndicator()
    IndicatorBeam.beam.Enabled = false
end

-- ============ TWEEN MOVER (BodyVelocity + BodyGyro) ============
-- Bukan TweenService: karakter digerakin lewat fisika. Tiap Heartbeat, velocity
-- di-set lurus ke target dengan kecepatan Settings.TweenSpeed (stud/detik), badan
-- dihadapin ke arah gerak lewat BodyGyro. Selama tween Humanoid.PlatformStand = true
-- biar animasi/fisika jalan bawaan gak ngelawan. Watchdog: kalau dalam 1 detik
-- gerak < 2 stud (nyangkut), noclip dinyalain sampai segmen ini selesai.
local TWEEN_STOP_DISTANCE = 2.5
local TweenNoclip = { conn = nil, saved = {} }

local function setTweenNoclip(on)
    if on then
        if TweenNoclip.conn then return end
        TweenNoclip.saved = {}
        TweenNoclip.conn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    TweenNoclip.saved[part] = true
                    part.CanCollide = false
                end
            end
        end)
    else
        if TweenNoclip.conn then
            TweenNoclip.conn:Disconnect()
            TweenNoclip.conn = nil
        end
        for part in pairs(TweenNoclip.saved) do
            if part and part.Parent then
                part.CanCollide = true
            end
        end
        TweenNoclip.saved = {}
    end
end

-- ============ Geppo pass ============
-- Di source, selama tween jalan ada loop yang manggil skill Geppo/Sky Walk milik
-- game (Events.Skill:InvokeServer) tiap ~0.1 detik, jadi server ngeliat karakter
-- lagi "pakai skill gerak udara". Skill yang dipanggil tergantung FightingStyle.
-- Di sini cuma manggil skill-nya aja (stamina TIDAK di-spoof), jadi stamina
-- tetap kepake normal. Kalau karakter gak punya skill-nya, gak ada efek.
local function fireGeppoOnce()
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local statsFolder = ReplicatedStorage:FindFirstChild("Stats" .. LocalPlayer.Name)
        local stats = statsFolder and statsFolder:FindFirstChild("Stats")
        local skills = statsFolder and statsFolder:FindFirstChild("Skills")
        local events = ReplicatedStorage:FindFirstChild("Events")
        local skill = events and events:FindFirstChild("Skill")
        if not skill then return end

        local cf = CFrame.lookAt(root.Position, root.Position + root.CFrame.LookVector + Vector3.new(0, 5, 0))
        local style = stats and stats:FindFirstChild("FightingStyle") and stats.FightingStyle.Value

        if style == "Rokushiki" then
            skill:InvokeServer("Geppo", {char = char, cf = cf})
        elseif style == "BlackLeg" then
            skill:InvokeServer("Sky Walk", {char = char, cf = cf})
        elseif style == "Kamishiki" then
            skill:InvokeServer("KamishikiGeppo", {char = char, cf = cf})
        elseif skills and skills:FindFirstChild("skyWalk") and skills.skyWalk.Value == true then
            skill:InvokeServer("Sky Walk2", {char = char, cf = cf})
        end
    end)
end

-- Return: true kalau sampai, false kalau timeout/dibatalkan/nyangkut beneran
-- Deteksi stuck berbasis PROGRESS (jarak ke target berkurang atau enggak), bukan
-- cuma "badan gerak atau enggak" - jadi karakter yang mantul-mantul di atas atap
-- (misal gara-gara Geppo) tetap kedeteksi nyangkut.
-- Urutan penanganan kalau nyangkut:
--   1) noclip nyala (tembus atap/tembok)
--   2) kalau masih gak ada progress beberapa kali -> return false, nanti
--      walkToDoorHeld ngitung ulang rute dari posisi sekarang (max 3x), lalu
--      door itu di-skip & dihitung.
local NOCLIP_FROM_START = false -- true = noclip nyala dari awal tween (lebih "nembus", tapi lebih mencolok)

-- Tween NEMPEL GROUND: selama noclip belum nyala, gerak cuma horizontal ke arah target,
-- sedangkan tinggi badan diikutin dari lantai di bawahnya (raycast ke bawah). Jadi
-- karakter gak naik ke atas (atap / udara) dan kalau lagi melayang (mis. abis Geppo)
-- otomatis diturunin sampai napak ground. Kalau noclip nyala (lagi nyangkut), gerak
-- balik lurus 3D ke target biar bisa tembus.
local TWEEN_GROUND_FOLLOW = true
local GROUND_RAY_LENGTH = 80  -- seberapa jauh ke bawah nyari ground (stud)
local GROUND_FOLLOW_GAIN = 12 -- makin besar, makin cepat nyesuaiin tinggi ke ground

-- Tinggi pusat HumanoidRootPart dari lantai pas karakter berdiri.
local function getStandingHeight(hum, root)
    if hum.RigType == Enum.HumanoidRigType.R6 then
        return 3
    end
    return hum.HipHeight + root.Size.Y / 2
end

-- ============ Cari tinggi ground di bawah karakter ============
-- Raycast ke bawah dari posisi karakter. Yang diabaikan: karakter sendiri, part yang
-- CanCollide=false, part buatan script ini (target/indikator), dan model yang punya
-- Humanoid (monster / pemain lain), biar gak "napak" di kepala monster.
-- Return: Y permukaan ground, atau nil kalau gak ada ground di bawah.
local GroundRayParams = RaycastParams.new()
GroundRayParams.FilterType = Enum.RaycastFilterType.Exclude
GroundRayParams.IgnoreWater = true
pcall(function() GroundRayParams.RespectCanCollide = true end)

local function getGroundY(pos)
    local ignore = {LocalPlayer.Character}
    for _ = 1, 5 do
        GroundRayParams.FilterDescendantsInstances = ignore
        local result = workspace:Raycast(pos, Vector3.new(0, -GROUND_RAY_LENGTH, 0), GroundRayParams)
        if not result then return nil end

        local inst = result.Instance
        local model = inst:FindFirstAncestorOfClass("Model")
        if string.sub(inst.Name, 1, 13) == "AutoEventDoor" then
            table.insert(ignore, inst)
        elseif model and model:FindFirstChildOfClass("Humanoid") then
            table.insert(ignore, model)
        else
            return result.Position.Y
        end
    end
    return nil
end

-- ============ Kondisi "noclip dilarang": hit / stun / ragdoll ============
-- Dipakai CUMA buat ngatur noclip di dalam tween. Tween-nya sendiri tetap jalan.
-- Selama kondisi ini aktif noclip dimatiin (collision balik) biar badan yang lagi
-- ragdoll gak tembus tanah; setelah selesai noclip balik diatur watchdog progress.
local HIT_NOCLIP_OFF_TIME = 1.5 -- detik noclip dimatiin setelah HP turun (kena hit)
local NOCLIP_BLOCK_MAX = 6      -- pengaman: satu kejadian maksimal nahan noclip segini lama

-- Belum pasti GPO nge-ragdoll lewat apa, jadi dicek beberapa cara umum:
--   Humanoid state (Ragdoll/FallingDown/Physics), attribute Ragdoll/Ragdolled di
--   Character, atau ada sendi Motor6D yang dimatiin (cara ragdoll paling umum).
-- Alasannya di-print sekali per jenis biar kelihatan mana yang kena di game-mu.
local RAGDOLL_STATES = {
    [Enum.HumanoidStateType.Ragdoll] = true,
    [Enum.HumanoidStateType.FallingDown] = true,
    [Enum.HumanoidStateType.Physics] = true,
}
local RagdollReasonPrinted = {}
local RagdollCache = { at = 0, value = false }

local function noteRagdoll(reason)
    if not RagdollReasonPrinted[reason] then
        RagdollReasonPrinted[reason] = true
        print("[AutoEventDoor] Ragdoll terdeteksi (" .. reason .. "), noclip dimatiin sementara.")
    end
end

-- Dicek paling sering tiap 0.1 detik (hasil di-cache) biar gak berat
local function isRagdolledNow()
    local now = tick()
    if now - RagdollCache.at < 0.1 then return RagdollCache.value end
    RagdollCache.at = now

    local result = false
    local hum, char = Humanoid, LocalPlayer.Character

    if hum and hum.Parent then
        local ok, state = pcall(function() return hum:GetState() end)
        if ok and RAGDOLL_STATES[state] then
            noteRagdoll("state " .. tostring(state))
            result = true
        end
    end

    if not result and char then
        if char:GetAttribute("Ragdoll") == true or char:GetAttribute("Ragdolled") == true then
            noteRagdoll("attribute Ragdoll")
            result = true
        else
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("Motor6D") and not d.Enabled then
                    noteRagdoll("Motor6D " .. d.Name .. " dimatiin")
                    result = true
                    break
                end
            end
        end
    end

    RagdollCache.value = result
    return result
end

local function tweenToPoint(targetPos, timeout, forceNoclip)
    timeout = timeout or 8

    local root, hum = RootPart, Humanoid
    if not root or not root.Parent or not hum or not hum.Parent then
        return false
    end

    -- PENYEBAB UTAMA tenggelam ke tanah + noclip terus-terusan:
    -- waypoint dari PathfindingService itu titik di LANTAI, sedangkan pusat
    -- HumanoidRootPart melayang ~3 stud di atas lantai. Jarak 3D ke waypoint jadi
    -- gak pernah bisa < TWEEN_STOP_DISTANCE (2.5) selama karakter berdiri di atas
    -- lantai. Akibatnya: karakter ditekan ke bawah, gak ada progress, watchdog
    -- nyalain noclip, lalu karakter tembus lantai buat "nyampe" ke titik itu.
    -- Solusi: tujuan dinaikin setinggi badan berdiri.
    local standH = getStandingHeight(hum, root)
    local goal = targetPos + Vector3.new(0, standH, 0)

    showDirectionIndicator(goal)

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "EvDoorTweenGyro"
    gyro.P = 200000
    gyro.D = 1000
    gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    gyro.CFrame = root.CFrame
    gyro.Parent = root

    local vel = Instance.new("BodyVelocity")
    vel.Name = "EvDoorTweenVel"
    vel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    vel.Velocity = Vector3.zero
    vel.Parent = root

    hum.PlatformStand = true
    hum.AutoRotate = false

    local startTime = tick()
    local noclipOn = false
    local reached = false

    if NOCLIP_FROM_START or forceNoclip then
        noclipOn = true
        setTweenNoclip(true)
    end

    local PROGRESS_CHECK_INTERVAL = 0.8 -- cek progress tiap sekian detik
    local MIN_PROGRESS = 1.5            -- minimal jarak yang harus berkurang per interval
    local MAX_NOCLIP_FAILS = 3          -- udah noclip tapi tetep gak progress sekian kali = nyerah
    local NEAR_FLAT_DISTANCE = 4        -- deket target secara horizontal = bukan nyangkut
    local lastDist = (goal - root.Position).Magnitude
    local lastCheck = tick()
    local noclipFails = 0

    -- Catat kapan terakhir kena hit (HP turun) selama tween. Dipakai buat
    -- matiin noclip sementara; tween-nya sendiri tetap jalan.
    local lastHealth = hum.Health
    local lastHitTime = 0
    local hitCount = 0
    local healthConn = hum.HealthChanged:Connect(function(h)
        if h < lastHealth - 0.01 then
            lastHitTime = tick()
            hitCount = hitCount + 1
            if hitCount == 1 then
                print(string.format("[AutoEventDoor] Kena hit saat tween (HP %.0f -> %.0f) di %s",
                    lastHealth, h, tostring(root.Position)))
            end
        end
        lastHealth = h
    end)

    -- true = noclip lagi dilarang (baru kena hit / stun / ragdoll). Ada batas
    -- NOCLIP_BLOCK_MAX biar kalau deteksi nyangkut true terus, noclip tetap bisa
    -- dipakai lagi (gak bikin karakter mentok selamanya).
    local blockSince = nil
    local function noclipBlocked()
        local blocked = (tick() - lastHitTime) < HIT_NOCLIP_OFF_TIME
            or isRagdolledNow()
            or isStunned()

        if blocked then
            blockSince = blockSince or tick()
            return (tick() - blockSince) <= NOCLIP_BLOCK_MAX
        end

        blockSince = nil
        return false
    end
    local wasBlocked = false

    local tweening = true
    if Settings.GeppoPass then
        task.spawn(function()
            while tweening and Enabled do
                -- Geppo ditembak terus selama tween jalan
                fireGeppoOnce() -- InvokeServer, jadi otomatis nunggu server
                task.wait(0.1)
            end
        end)
    end

    while Enabled and (tick() - startTime) < timeout do
        if not root.Parent then break end

        local pos = root.Position
        local delta = goal - pos
        local dist = delta.Magnitude
        local flat = Vector3.new(delta.X, 0, delta.Z)

        -- Sampai: dekat 3D, atau sudah pas di atas titik (selisih tinggi kecil)
        if dist <= TWEEN_STOP_DISTANCE
            or (flat.Magnitude <= TWEEN_STOP_DISTANCE and math.abs(delta.Y) <= 4) then
            reached = true
            break
        end

        -- Kena hit / stun / ragdoll: matiin noclip (tween TETAP jalan)
        local blocked = noclipBlocked()
        if blocked then
            if noclipOn then
                setTweenNoclip(false)
                noclipOn = false
            end
            wasBlocked = true
        elseif wasBlocked then
            wasBlocked = false
            -- Selesai: waktu hit/ragdoll jangan dihitung sebagai "nyangkut"
            lastCheck = tick()
            lastDist = dist
            noclipFails = 0
            -- Tween yang memang minta noclip dari awal: nyalain lagi
            if NOCLIP_FROM_START or forceNoclip then
                noclipOn = true
                setTweenNoclip(true)
            end
        end

        local dt = RunService.Heartbeat:Wait()

        local maxSpeed = math.max(Settings.TweenSpeed, 1)

        if TWEEN_GROUND_FOLLOW and not noclipOn then
            -- NEMPEL GROUND: horizontal ke target, tinggi ngikutin lantai di bawah
            local flatDist = flat.Magnitude
            local hSpeed = math.min(maxSpeed, flatDist / math.max(dt, 1 / 60))
            local hVel = Vector3.zero
            if flatDist > 0.05 then
                hVel = flat.Unit * hSpeed
            end

            local curPos = root.Position
            local groundY = getGroundY(curPos)
            local desiredY = groundY and (groundY + standH) or goal.Y
            local vy = math.clamp((desiredY - curPos.Y) * GROUND_FOLLOW_GAIN, -maxSpeed, maxSpeed)

            vel.Velocity = Vector3.new(hVel.X, vy, hVel.Z)
        else
            -- Noclip nyala (lagi nyangkut): lurus 3D ke target biar bisa tembus
            -- kecepatan dibatesin biar gak overshoot pas udah deket
            local speed = math.min(maxSpeed, dist / math.max(dt, 1 / 60))
            vel.Velocity = delta.Unit * speed
        end

        if flat.Magnitude > 0.5 then
            gyro.CFrame = CFrame.lookAt(pos, pos + flat)
        end
        IndicatorBeam.targetPart.Position = goal

        -- Watchdog progress
        if not blocked and tick() - lastCheck >= PROGRESS_CHECK_INTERVAL then
            local progress = lastDist - dist
            -- Deket target secara horizontal = lagi nyesuaiin tinggi, bukan nyangkut
            if progress < MIN_PROGRESS and flat.Magnitude > NEAR_FLAT_DISTANCE then
                if not noclipOn then
                    noclipOn = true
                    setTweenNoclip(true)
                else
                    noclipFails = noclipFails + 1
                    if noclipFails >= MAX_NOCLIP_FAILS then
                        print("[AutoEventDoor] Tween gak ada progress walau noclip, nyerah di titik ini.")
                        break
                    end
                end
            else
                noclipFails = 0
            end
            lastDist, lastCheck = dist, tick()
        end
    end

    tweening = false
    healthConn:Disconnect()
    pcall(function() vel:Destroy() end)
    pcall(function() gyro:Destroy() end)
    if noclipOn then
        setTweenNoclip(false)
    end
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    pcall(function()
        hum.PlatformStand = false
        hum.AutoRotate = true
    end)
    hideDirectionIndicator()

    return reached
end

-- ============ Movement per-waypoint, dengan deteksi stuck beneran ============
-- Return: true kalau sampai, false kalau stuck/timeout/dibatalkan
local function walkToPointHeld(targetPos, timeout)
    timeout = timeout or 8

    -- Mode tween: gerak lewat BodyVelocity, bukan hold WASD
    if Settings.TweenMode then
        return tweenToPoint(targetPos, timeout)
    end

    local startTime = tick()
    enableMovementMode()
    showDirectionIndicator(targetPos)

    local lastPos = RootPart.Position
    local lastMoveCheck = tick()
    local STUCK_CHECK_INTERVAL = 0.6
    local STUCK_DISTANCE_THRESHOLD = 1.0
    local stuckStrikes = 0
    local MAX_STUCK_STRIKES = 3 -- udah dicoba lepasin diri 3x tapi tetep gak gerak = nyerah di titik ini

    -- Maneuver "lepas diri" kalau nempel tembok lurus: mundur dulu (S) biar gak
    -- nempel lagi, baru strafe tegas ke samping (A/D), baru lanjut coba maju lagi.
    -- Jauh lebih efektif daripada cuma nyerong 35 derajat doang buat tembok lebar/lurus.
    local function performUnstuckManeuver(strikeCount)
        releaseAllMoveKeys()

        -- Strike pertama: coba yang paling murah dulu, lompat di tempat
        if strikeCount <= 1 then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.15)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            task.wait(0.2)
            return
        end

        -- Strike ke-2+: mundur dulu biar lepas dari tembok
        setKeyHeld(Enum.KeyCode.S, true)
        task.wait(0.5)
        setKeyHeld(Enum.KeyCode.S, false)

        -- Strafe tegas ke sisi yang lebih kosong (cek whisker kiri/kanan sekali lagi)
        local origin = RootPart.Position
        local flatDir = Vector3.new(targetPos.X - origin.X, 0, targetPos.Z - origin.Z)
        local strafeKey = Enum.KeyCode.D -- default

        if flatDir.Magnitude > 0.1 then
            flatDir = flatDir.Unit
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {Character}

            local rayOrigin = origin + Vector3.new(0, 1, 0)
            local leftDir = CFrame.Angles(0, math.rad(90), 0) * flatDir
            local rightDir = CFrame.Angles(0, -math.rad(90), 0) * flatDir

            local leftResult = workspace:Raycast(rayOrigin, leftDir * 5, params)
            local rightResult = workspace:Raycast(rayOrigin, rightDir * 5, params)

            if leftResult and not rightResult then
                strafeKey = Enum.KeyCode.D
            elseif rightResult and not leftResult then
                strafeKey = Enum.KeyCode.A
            else
                strafeKey = (strikeCount % 2 == 0) and Enum.KeyCode.D or Enum.KeyCode.A
            end
        end

        setKeyHeld(strafeKey, true)
        task.wait(0.6)
        setKeyHeld(strafeKey, false)

        -- Lompat sekali lagi buat jaga-jaga ada ledge/step kecil
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.15)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        task.wait(0.2)
    end

    local reached = false

    while Enabled and (tick() - startTime) < timeout do
        local dist = (RootPart.Position - targetPos).Magnitude
        if dist <= WAYPOINT_REACH_DISTANCE then
            reached = true
            break
        end

        -- STUN: lepas semua tombol, tunggu stun habis, jangan hitung sebagai stuck
        if isStunned() then
            releaseAllMoveKeys()
            local stunStart = tick()
            waitUntilNotStunned()
            startTime = startTime + (tick() - stunStart)
            lastPos = RootPart.Position
            lastMoveCheck = tick()
            stuckStrikes = 0
            continue
        end

        RunService.Heartbeat:Wait()

        updateMoveKeysTowards(targetPos)
        IndicatorBeam.targetPart.Position = targetPos

        if tick() - lastMoveCheck >= STUCK_CHECK_INTERVAL then
            local moved = (RootPart.Position - lastPos).Magnitude
            if moved < STUCK_DISTANCE_THRESHOLD then
                stuckStrikes = stuckStrikes + 1

                if stuckStrikes >= MAX_STUCK_STRIKES then
                    -- Beneran stuck (ketahan tembok/geometri), nyerah di waypoint ini
                    -- biar caller bisa recompute path dari posisi sekarang
                    releaseAllMoveKeys()
                    hideDirectionIndicator()
                    return false
                end

                performUnstuckManeuver(stuckStrikes)
            else
                stuckStrikes = 0
            end
            lastPos = RootPart.Position
            lastMoveCheck = tick()
        end
    end

    releaseAllMoveKeys()
    hideDirectionIndicator()
    return reached
end

-- Compute path dengan beberapa fallback AgentRadius, kalau radius pertama gagal
local AGENT_RADIUS_FALLBACKS = {2, 1.5, 3, 1}

local function computePathWaypoints(fromPos, toPos)
    for _, radius in ipairs(AGENT_RADIUS_FALLBACKS) do
        local path = PathfindingService:CreatePath({
            AgentRadius = radius,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentJumpHeight = 7,
            AgentMaxSlope = 45,
        })

        local success = pcall(function()
            path:ComputeAsync(fromPos, toPos)
        end)

        if success and path.Status == Enum.PathStatus.Success then
            return path:GetWaypoints()
        end
    end

    -- Semua fallback gagal, pakai garis lurus sebagai usaha terakhir
    return { { Position = toPos } }
end

-- Filter waypoint yang terlalu rapat (zigzag kecil bikin arah berubah drastis)
-- PENTING: filter ini gak boleh cuma liat JARAK doang. Waypoint yang nandain
-- BELOKAN TAJAM (misal mau masuk pintu dari sisi tertentu) harus tetep
-- dipertahankan meskipun jaraknya deket, soalnya kalau di-skip, karakter bakal
-- jalan lurus ke waypoint berikutnya yang lebih jauh dan malah lewat jalur yang
-- salah / nembus/ngelilingin bangunan dari sisi yang keliru.
local function filterWaypoints(waypoints, fromPos)
    local MIN_WAYPOINT_GAP = 10
    local TURN_ANGLE_THRESHOLD = 35 -- derajat - belokan setajam ini WAJIB dipertahankan

    local filtered = {}
    local lastPos = fromPos
    local lastDir = nil -- arah dari waypoint kept sebelumnya ke lastPos

    for i, wp in ipairs(waypoints) do
        local isLast = (i == #waypoints)
        local gap = (wp.Position - lastPos).Magnitude

        local isSharpTurn = false
        if lastDir and gap > 0.1 then
            local newDir = (wp.Position - lastPos).Unit
            local dot = math.clamp(lastDir:Dot(newDir), -1, 1)
            local angle = math.deg(math.acos(dot))
            if angle >= TURN_ANGLE_THRESHOLD then
                isSharpTurn = true
            end
        end

        if isLast or gap >= MIN_WAYPOINT_GAP or isSharpTurn or wp.Action == Enum.PathWaypointAction.Jump then
            if gap > 0.1 then
                lastDir = (wp.Position - lastPos).Unit
            end
            table.insert(filtered, wp)
            lastPos = wp.Position
        end
    end

    return filtered
end

local MAX_PATH_ATTEMPTS = 3 -- recompute path dari posisi sekarang sampai sekian kali sebelum nyerah di door ini

local function walkToDoorHeld(door)
    local pos = getDoorPosition(door)
    if not pos then return false end

    if (RootPart.Position - pos).Magnitude <= MINE_DISTANCE then
        return true
    end

    for attempt = 1, MAX_PATH_ATTEMPTS do
        if not Enabled or not door.Parent then
            releaseAllMoveKeys()
            return false
        end

        local currentDoorPos = getDoorPosition(door)
        if not currentDoorPos then return false end

        if (RootPart.Position - currentDoorPos).Magnitude <= MINE_DISTANCE then
            return true
        end

        local waypoints = computePathWaypoints(RootPart.Position, currentDoorPos)
        local filteredWaypoints = filterWaypoints(waypoints, RootPart.Position)

        local gotStuck = false

        for _, wp in ipairs(filteredWaypoints) do
            if not Enabled then
                releaseAllMoveKeys()
                return false
            end
            if not door.Parent then
                releaseAllMoveKeys()
                return false
            end

            local checkDoorPos = getDoorPosition(door)
            if checkDoorPos and (RootPart.Position - checkDoorPos).Magnitude <= MINE_DISTANCE then
                releaseAllMoveKeys()
                return true
            end

            local reached = walkToPointHeld(wp.Position, 8)
            if not reached then
                gotStuck = true
                break -- waypoint ini gagal, keluar & recompute path dari posisi sekarang
            end
        end

        if not gotStuck then
            -- Semua waypoint di-pass tanpa stuck, cek posisi akhir
            local finalDoorPos = getDoorPosition(door)
            if finalDoorPos and (RootPart.Position - finalDoorPos).Magnitude <= MINE_DISTANCE then
                return true
            end
            -- Udah nyampe ujung waypoint tapi belum cukup deket (jarang terjadi) - coba lagi
        end
    end

    -- Udah dicoba berkali-kali tetep gagal, nyerah di door ini
    releaseAllMoveKeys()
    return false
end

