function Bridge.validate(key, value)
    local rule = Bridge.rules[key]
    if not rule then
        return false, "setting gak dikenal / gak boleh diubah: " .. tostring(key)
    end

    local kind = rule[1]
    if kind == "boolean" then
        if type(value) ~= "boolean" then return false, key .. " harus true/false" end
        return true, value
    elseif kind == "string" then
        if type(value) ~= "string" then return false, key .. " harus teks" end
        if #value > rule[2] then return false, key .. " terlalu panjang (maks " .. rule[2] .. " karakter)" end
        return true, value
    end

    -- number / int
    if type(value) ~= "number" or value ~= value then return false, key .. " harus angka" end
    if value < rule[2] or value > rule[3] then
        return false, string.format("%s di luar rentang %s..%s", key, tostring(rule[2]), tostring(rule[3]))
    end
    if kind == "int" then value = math.floor(value) end
    return true, value
end

function Bridge.settings()
    local out = {}
    for key in pairs(Bridge.rules) do out[key] = Settings[key] end
    out.farmEnabled = Enabled
    out.webhookItemNotif = Webhook.Enabled
    out.webhookSummary = Webhook.SummaryEnabled
    out.webhookRare = Webhook.Rare
    return out
end

function Bridge.setSetting(key, value)
    local ok, v = Bridge.validate(key, value)
    if not ok then error(v, 0) end

    Settings[key] = v

    if key == "WalkSpeedEnabled" or key == "WalkSpeed" then
        if Settings.WalkSpeedEnabled then
            Humanoid.WalkSpeed = Settings.WalkSpeed
        elseif key == "WalkSpeedEnabled" then
            Humanoid.WalkSpeed = 16 -- balikin ke default Roblox
        end
    elseif key == "FpsCapEnabled" or key == "FpsCap" then
        if Settings.FpsCapEnabled then Fps.apply() else Fps.release() end
    end

    UI.syncFromSettings()
    print("[AutoEventDoor] Bridge: " .. key .. " = " .. tostring(v))
    return { key = key, value = v }
end

function Bridge.snapshot()
    local detail = Stat.detail
    if Stat.detailFn then
        local ok, res = pcall(Stat.detailFn)
        detail = ok and tostring(res or "") or ""
    end

    local cooling, now = 0, tick()
    for door in pairs(LastVisit) do
        if door.Parent and now < getDoorReadyAt(door) then cooling = cooling + 1 end
    end

    local pos = RootPart and RootPart.Position
    return {
        farmEnabled = Enabled,
        status = {
            title = Stat.title, detail = detail, note = Stat.note,
            kind = Stat.kind, seconds = math.floor(now - Stat.since),
        },
        doors = { cooldown = cooling, total = LastKnownDoorCount, failStreak = Nav.failStreak },
        candy = getCandyCount(),
        candyTarget = Settings.CandyTarget,
        chest = getChestCount(),
        fps = Fps.current,
        mode = Settings.TweenMode and "tween" or "wasd",
        health = Humanoid and Humanoid.Health or nil,
        position = pos and {
            x = math.floor(pos.X * 10) / 10, y = math.floor(pos.Y * 10) / 10, z = math.floor(pos.Z * 10) / 10,
        } or nil,
        place = game.PlaceId,
        stats = {
            hourWindow = Webhook.stats.win, total = Webhook.stats.tot,
            activeSeconds = math.floor(Webhook.active("tot")),
            sessionSeconds = math.floor(now - Webhook.stats.startedAt),
        },
    }
end

function Bridge.doors()
    local list, now = {}, tick()
    for _, door in ipairs(getAllEventDoors()) do
        local pos = getDoorPosition(door)
        table.insert(list, {
            label = doorLabel(door),
            readyIn = math.max(0, math.floor(getDoorReadyAt(door) - now)),
            distance = pos and math.floor((RootPart.Position - pos).Magnitude) or nil,
        })
        if #list >= 100 then break end
    end
    table.sort(list, function(a, b) return (a.distance or 1e9) < (b.distance or 1e9) end)
    return { count = #list, doors = list }
end

function Bridge.getLog(n)
    n = math.clamp(math.floor(tonumber(n) or 50), 1, LogBuffer.max)
    local lines = LogBuffer.lines
    local out = {}
    for i = math.max(1, #lines - n + 1), #lines do table.insert(out, lines[i]) end
    return { count = #out, lines = out }
end

-- Satu-satunya pintu masuk perintah dari luar
function Bridge.handle(cmd, args)
    args = type(args) == "table" and args or {}

    if cmd == "ping" then
        return { pong = true, time = os.time() }
    elseif cmd == "get_status" then
        return Bridge.snapshot()
    elseif cmd == "get_settings" then
        return Bridge.settings()
    elseif cmd == "set_setting" then
        return Bridge.setSetting(args.key, args.value)
    elseif cmd == "set_farm" then
        setEnabled(args.enabled == true)
        return { farmEnabled = Enabled }
    elseif cmd == "get_log" then
        return Bridge.getLog(args.lines)
    elseif cmd == "get_inventory" then
        return Webhook.snapshot()
    elseif cmd == "get_doors" then
        return Bridge.doors()
    elseif cmd == "send_summary" then
        if not Webhook.valid() then error("URL webhook belum valid", 0) end
        Webhook.sendSummary(true)
        return { sent = true }
    end

    error("perintah gak dikenal: " .. tostring(cmd), 0)
end

-- ---------- transport ----------
function Bridge.reply(id, ok, data)
    local Http = game:GetService("HttpService")
    local entry = { id = id, ok = ok, data = data }

    local okEnc = pcall(Http.JSONEncode, Http, entry)
    if not okEnc then
        entry = { id = id, ok = false, data = "hasil gak bisa di-encode ke JSON" }
    end

    if Bridge.transport == "ws" and Bridge.ws then
        entry.type = "result"
        pcall(function() Bridge.ws:Send(Http:JSONEncode(entry)) end)
    else
        table.insert(Bridge.outbox, entry)
    end
end

function Bridge.onCommand(msg)
    if type(msg) ~= "table" or msg.type ~= "cmd" or msg.id == nil then return end
    task.spawn(function()
        local ok, res = pcall(Bridge.handle, msg.cmd, msg.args)
        Bridge.reply(msg.id, ok, ok and res or tostring(res))
    end)
end

function Bridge.request(path, body)
    local req = request or http_request or (syn and syn.request)
    if typeof(req) ~= "function" then error("executor gak punya request/http_request", 0) end
    return req({
        Url = string.format("http://%s:%d%s", Bridge.Host, Bridge.Port, path),
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["X-Bridge-Token"] = Bridge.Token },
        Body = game:GetService("HttpService"):JSONEncode(body),
    })
end

-- Cadangan kalau executor gak punya WebSocket: polling HTTP ~1x/detik
function Bridge.pollLoop(gen)
    local Http = game:GetService("HttpService")
    local fails, first = 0, true

    while Bridge.Enabled and Bridge.gen == gen do
        local results = Bridge.outbox
        Bridge.outbox = {}

        local okr, res = pcall(Bridge.request, "/poll", {
            hello = first, user = LocalPlayer.Name, place = game.PlaceId, results = results,
        })

        if okr and res and res.StatusCode == 200 then
            first, fails = false, 0
            Bridge.transport, Bridge.connected, Bridge.lastError = "http", true, ""
            local okd, data = pcall(Http.JSONDecode, Http, res.Body)
            if okd and type(data) == "table" and type(data.commands) == "table" then
                for _, cmd in ipairs(data.commands) do Bridge.onCommand(cmd) end
            end
        else
            for _, r in ipairs(results) do table.insert(Bridge.outbox, r) end
            fails = fails + 1
            Bridge.connected = false
            if okr and res and res.StatusCode == 401 then
                Bridge.lastError = "token salah"
                return
            end
            if fails >= 3 then return end
        end
        task.wait(1)
    end
end

function Bridge.run(gen)
    local Http = game:GetService("HttpService")
    local backoff = 2

    while Bridge.Enabled and Bridge.gen == gen do
        local usedWs = false

        if WebSocket and WebSocket.connect then
            local url = string.format("ws://%s:%d/ws?token=%s", Bridge.Host, Bridge.Port, Http:UrlEncode(Bridge.Token))
            local okc, ws = pcall(function() return WebSocket.connect(url) end)
            if okc and ws then
                usedWs = true
                Bridge.ws, Bridge.transport, Bridge.connected, Bridge.lastError = ws, "ws", true, ""
                local closed = false

                ws.OnMessage:Connect(function(raw)
                    local okd, msg = pcall(Http.JSONDecode, Http, raw)
                    if okd then Bridge.onCommand(msg) end
                end)
                ws.OnClose:Connect(function() closed = true end)
                pcall(function()
                    ws:Send(Http:JSONEncode({ type = "hello", user = LocalPlayer.Name, place = game.PlaceId }))
                end)

                backoff = 2
                while Bridge.Enabled and Bridge.gen == gen and not closed do
                    task.wait(0.5)
                end
                pcall(function() ws:Close() end)
                if Bridge.ws == ws then Bridge.ws = nil end
                Bridge.connected = false
            end
        end

        if not usedWs and Bridge.Enabled and Bridge.gen == gen then
            Bridge.pollLoop(gen)
        end

        if Bridge.Enabled and Bridge.gen == gen then
            task.wait(backoff)
            backoff = math.min(backoff * 2, 15)
        end
    end

    if Bridge.gen == gen then Bridge.connected = false end
end

function Bridge.restart()
    Bridge.gen = Bridge.gen + 1
    local gen = Bridge.gen

    if Bridge.ws then
        pcall(function() Bridge.ws:Close() end)
        Bridge.ws = nil
    end
    Bridge.connected = false
    Bridge.lastError = ""

    if not Bridge.Enabled then return end
    if Bridge.Token == "" then
        Bridge.lastError = "isi token dulu"
        print("[AutoEventDoor] Bridge: token kosong (samakan dengan bridge_token.txt di folder bridge_server.py).")
        return
    end
    task.spawn(Bridge.run, gen)
end

function Bridge.start()
    task.spawn(function()
        while true do
            local label = Bridge.StatusLabel
            if label then
                if not Bridge.Enabled then
                    label.Text, label.TextColor3 = "OFF", UI.C.dim
                elseif Bridge.connected then
                    label.Text, label.TextColor3 = "Terhubung (" .. Bridge.transport .. ")", UI.C.on
                else
                    local why = Bridge.lastError ~= "" and Bridge.lastError or "menunggu server..."
                    label.Text, label.TextColor3 = why, UI.C.candy
                end
            end
            task.wait(1)
        end
    end)

    if Bridge.Enabled then Bridge.restart() end
end

Fps.start()
Webhook.start()
Bridge.start()

