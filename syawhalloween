-- print yang dipakai script ini ikut disimpan ke buffer (dibaca bridge / MCP); print asli tetap jalan.
local LogBuffer = { lines = {}, max = 200 }
local rawPrint = print
local function print(...)
    rawPrint(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring((select(i, ...)))
    end
    table.insert(LogBuffer.lines, os.date("%H:%M:%S") .. " " .. table.concat(parts, " "))
    if #LogBuffer.lines > LogBuffer.max then table.remove(LogBuffer.lines, 1) end
end

