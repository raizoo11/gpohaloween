-- FARM MOB (TP Above/Behind/Bottom via slider offsets, auto search & refresh, range 70 studs, anti-aerial)
----------------------------------------------------------------
local farmEnabled = false
local farmMode = "Above"
local farmOffsetX, farmOffsetY, farmOffsetZ = 0, 5, 5
local farmKeybind = Enum.KeyCode.F4
local capturingFarmKeybind = false
local FARM_DETECT_RANGE = 70

local currentFarmTarget = nil

local function isValidFarmTarget(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then return false end
    local dist = (root.Position - rootPart.Position).Magnitude
    return dist <= FARM_DETECT_RANGE
end

local function getNearestFightableNPC()
    local folder = workspace:FindFirstChild("FightableNPCS")
    if not folder then return nil end

    local nearest, nearestDist = nil, math.huge
    for _, model in ipairs(folder:GetChildren()) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root then
            local dist = (root.Position - rootPart.Position).Magnitude
            if dist <= FARM_DETECT_RANGE and dist < nearestDist then
                nearestDist = dist
                nearest = model
            end
        end
    end
    return nearest
end

local MIN_BEHIND_DISTANCE = 3

local function computeFarmCFrame(targetRoot)
    local targetCFrame = targetRoot.CFrame
    local offsetPos

    if farmMode == "Above" then
        offsetPos = targetCFrame.Position + Vector3.new(farmOffsetX, math.abs(farmOffsetY), farmOffsetZ)
    elseif farmMode == "Bottom" then
        offsetPos = targetCFrame.Position + Vector3.new(farmOffsetX, -math.abs(farmOffsetY), farmOffsetZ)
    elseif farmMode == "Behind" then
        local behindDist = math.max(math.abs(farmOffsetZ), MIN_BEHIND_DISTANCE)
        local backOffset = targetCFrame.LookVector * -behindDist
        offsetPos = targetCFrame.Position + backOffset + Vector3.new(farmOffsetX, farmOffsetY, 0)
    else
        offsetPos = targetCFrame.Position + Vector3.new(farmOffsetX, farmOffsetY, farmOffsetZ)
    end

    return CFrame.new(offsetPos, targetCFrame.Position)
end

RunService.Heartbeat:Connect(function()
    if not farmEnabled then return end
    if not character or not character.Parent then return end
    if flyEnabled then return end

    if not isValidFarmTarget(currentFarmTarget) then
        currentFarmTarget = getNearestFightableNPC()
    end

    if currentFarmTarget then
        local targetRoot = currentFarmTarget:FindFirstChild("HumanoidRootPart")
        if targetRoot and rootPart then
            rootPart.CFrame = computeFarmCFrame(targetRoot)
        end
    end

    if humanoid:GetState() == Enum.HumanoidStateType.Freefall then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
end)

task.spawn(function()
    while true do
        if farmEnabled and isValidFarmTarget(currentFarmTarget) then
            local betterTarget = getNearestFightableNPC()
            if betterTarget and betterTarget ~= currentFarmTarget then
                local currentDist = (currentFarmTarget.HumanoidRootPart.Position - rootPart.Position).Magnitude
                local betterDist = (betterTarget.HumanoidRootPart.Position - rootPart.Position).Magnitude
                if betterDist < currentDist - 5 then
                    currentFarmTarget = betterTarget
                end
            end
        end
        task.wait(1)
    end
end)

local function toggleFarm()
    farmEnabled = not farmEnabled
    if farmEnabled then
        currentFarmTarget = nil
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    else
        currentFarmTarget = nil
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
    end
end

