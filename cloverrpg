----------------------------------------------------------------
-- WALKSPEED
----------------------------------------------------------------
local WALK_SPEED_VALUE = 30
local DEFAULT_SPEED = 16

local walkSpeedEnabled = false
local enforcingSpeed = false
local walkspeedKeybind = Enum.KeyCode.F1
local capturingWSKeybind = false

local function applyWalkSpeed()
    local targetSpeed = walkSpeedEnabled and WALK_SPEED_VALUE or DEFAULT_SPEED
    if humanoid.WalkSpeed ~= targetSpeed then
        enforcingSpeed = true
        humanoid.WalkSpeed = targetSpeed
        enforcingSpeed = false
    end
end

local function watchWalkSpeed(hum)
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if enforcingSpeed then return end
        if walkSpeedEnabled then applyWalkSpeed() end
    end)
end
watchWalkSpeed(humanoid)

----------------------------------------------------------------
-- NOCLIP
----------------------------------------------------------------
local noclipEnabled = false
local noclipConn = nil
local noclipKeybind = Enum.KeyCode.F2
local capturingNoclipKeybind = false

local function startNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        if character then
            for _, v in pairs(character:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then
                    v.CanCollide = false
                end
            end
        end
    end)
end

local function stopNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    if character then
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end
end

local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        startNoclip()
    else
        stopNoclip()
    end
end

LocalPlayer.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    applyWalkSpeed()
    watchWalkSpeed(humanoid)
    if noclipEnabled then
        startNoclip()
    end
end)

