    local alpha = math.clamp((inputX - trackAbsPos) / trackAbsSize, 0, 1)
    local newSpeed = MIN_SPEED + alpha * (MAX_SPEED - MIN_SPEED)
    setWalkSpeedValue(newSpeed)
end

