    btn.TextSize = 13
    btn.Parent = espTab

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        toggleFn()
        local isOn = isOnFn()
        btn.Text = label .. ": " .. (isOn and "ON" or "OFF")
        btn.BackgroundColor3 = isOn and Color3.fromRGB(40, 160, 70) or Color3.fromRGB(180, 40, 40)
    end)

    return btn
end

