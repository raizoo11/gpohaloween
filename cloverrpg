----------------------------------------------------------------
-- WALKSPEED
----------------------------------------------------------------
local WALK_SPEED_VALUE = 30
local DEFAULT_SPEED = 16

local walkSpeedEnabled = false
local enforcingSpeed = false
local walkspeedKeybind = Enum.KeyCode.F1
local capturingWSKeybind = false

local function applyWalkSpeed()
    local targetSpeed = walkSpeedEnabled and WALK_SPEED_VALUE or DEFAULT_SPEED
    if humanoid.WalkSpeed ~= targetSpeed then
        enforcingSpeed = true
        humanoid.WalkSpeed = targetSpeed
        enforcingSpeed = false
    end
end

local function watchWalkSpeed(hum)
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if enforcingSpeed then return end
        if walkSpeedEnabled then applyWalkSpeed() end
    end)
end
watchWalkSpeed(humanoid)

local function toggleWalkSpeed()
    walkSpeedEnabled = not walkSpeedEnabled
    applyWalkSpeed()
end

----------------------------------------------------------------
-- NOCLIP
----------------------------------------------------------------
local noclipEnabled = false
local noclipConn = nil
local noclipKeybind = Enum.KeyCode.F2
local capturingNoclipKeybind = false

local function startNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        if character then
            for _, v in pairs(character:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then
                    v.CanCollide = false
                end
            end
        end
    end)
end

local function stopNoclip()
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    if character then
        for _, v in pairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end
end

local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        startNoclip()
    else
        stopNoclip()
    end
end

----------------------------------------------------------------
-- FLY (dengan fix rubberband: SetNetworkOwner ke client)
----------------------------------------------------------------
local FLY_SPEED_VALUE = 50
local flyEnabled = false
local flyKeybind = Enum.KeyCode.F3
local capturingFlyKeybind = false

local bodyVelocity = nil
local bodyGyro = nil
local flyConn = nil

local keysHeld = {
    W = false, A = false, S = false, D = false,
    Up = false, Down = false,
}

local function startFly()
    if flyEnabled then return end
    flyEnabled = true

    humanoid.PlatformStand = true

    pcall(function()
        rootPart:SetNetworkOwner(LocalPlayer)
    end)

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 3000
    bodyGyro.D = 100
    bodyGyro.Parent = rootPart

    flyConn = RunService.Heartbeat:Connect(function()
        if not rootPart or not rootPart.Parent then return end

        local camCFrame = camera.CFrame
        local moveDir = Vector3.new(0, 0, 0)

        local flatLook = Vector3.new(camCFrame.LookVector.X, 0, camCFrame.LookVector.Z)
        if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
        local flatRight = Vector3.new(camCFrame.RightVector.X, 0, camCFrame.RightVector.Z)
        if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

        if keysHeld.W then moveDir += flatLook end
        if keysHeld.S then moveDir -= flatLook end
        if keysHeld.D then moveDir += flatRight end
        if keysHeld.A then moveDir -= flatRight end

        local verticalDir = 0
        if keysHeld.Up then verticalDir += 1 end
        if keysHeld.Down then verticalDir -= 1 end

        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
        end

        local finalVelocity = (moveDir * FLY_SPEED_VALUE) + Vector3.new(0, verticalDir * FLY_SPEED_VALUE, 0)
        bodyVelocity.Velocity = finalVelocity

        bodyGyro.CFrame = CFrame.new(rootPart.Position, rootPart.Position + camCFrame.LookVector)
    end)
end

local function stopFly()
    if not flyEnabled then return end
    flyEnabled = false

    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    if humanoid then
        humanoid.PlatformStand = false
    end

    pcall(function()
        rootPart:SetNetworkOwnershipAuto()
    end)

    for k in pairs(keysHeld) do
        keysHeld[k] = false
    end
end

local function toggleFly()
    if flyEnabled then
        stopFly()
    else
        startFly()
    end
end

----------------------------------------------------------------
-- VISUAL: NOFOG + FULLBRIGHT + NO ATMOSPHERE
----------------------------------------------------------------
local visualEnabled = false
local savedAtmosphereData = {}

local originalLighting = {
    FogEnd = Lighting.FogEnd,
    FogStart = Lighting.FogStart,
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    GlobalShadows = Lighting.GlobalShadows,
    ExposureCompensation = Lighting.ExposureCompensation,
}

local function neutralizeAtmosphere()
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") and not savedAtmosphereData[obj] then
            savedAtmosphereData[obj] = {
                Density = obj.Density,
                Offset = obj.Offset,
                Color = obj.Color,
                Decay = obj.Decay,
                Glare = obj.Glare,
                Haze = obj.Haze,
            }
            obj.Density = 0
            obj.Offset = 0
            obj.Decay = Color3.new(0, 0, 0)
            obj.Glare = 0
            obj.Haze = 0
        end
    end
end

local function restoreAtmosphere()
    for obj, data in pairs(savedAtmosphereData) do
        if obj and obj.Parent then
            obj.Density = data.Density
            obj.Offset = data.Offset
            obj.Color = data.Color
            obj.Decay = data.Decay
            obj.Glare = data.Glare
            obj.Haze = data.Haze
        end
    end
    savedAtmosphereData = {}
end

local function applyVisual()
    if visualEnabled then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.GlobalShadows = false
        Lighting.ExposureCompensation = 1
        neutralizeAtmosphere()
    else
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.ExposureCompensation = originalLighting.ExposureCompensation
        restoreAtmosphere()
    end
end

local function toggleVisual()
    visualEnabled = not visualEnabled
    applyVisual()
end

task.spawn(function()
    while true do
        if visualEnabled then
            if Lighting.FogEnd ~= 100000 then Lighting.FogEnd = 100000 end
            if Lighting.FogStart ~= 0 then Lighting.FogStart = 0 end
            if Lighting.Brightness ~= 3 then Lighting.Brightness = 3 end
            if Lighting.ExposureCompensation ~= 1 then Lighting.ExposureCompensation = 1 end
            neutralizeAtmosphere()
        end
        task.wait(1)
    end
end)

Lighting.ChildAdded:Connect(function(obj)
    if visualEnabled and obj:IsA("Atmosphere") then
        task.wait(0.1)
        neutralizeAtmosphere()
    end
end)

