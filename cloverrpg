            noclipKeybindBtn.Text = tostring(noclipKeybind.Name)
            noclipKeybindBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 160)
            capturingNoclipKeybind = false
        end
        return
    end

    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == walkspeedKeybind then
            toggleWalkSpeed()
        elseif input.KeyCode == noclipKeybind then
            toggleNoclip()
            refreshNoclipToggleUI()
        end
    end
end)

