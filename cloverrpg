UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if capturingWSKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            walkspeedKeybind = input.KeyCode
            if wsKeybindBtn then
                wsKeybindBtn.Text = tostring(walkspeedKeybind.Name) .. " (Keybind WalkSpeed)"
                wsKeybindBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 160)
            end
            capturingWSKeybind = false
        end
        return
    end

    if capturingNoclipKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            noclipKeybind = input.KeyCode
            if noclipKeybindBtn then
                noclipKeybindBtn.Text = tostring(noclipKeybind.Name) .. " (Keybind Noclip)"
                noclipKeybindBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 160)
            end
            capturingNoclipKeybind = false
        end
        return
    end

    if capturingFlyKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            flyKeybind = input.KeyCode
            if flyKeybindBtn then
                flyKeybindBtn.Text = tostring(flyKeybind.Name) .. " (Keybind Fly)"
                flyKeybindBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 160)
            end
            capturingFlyKeybind = false
        end
        return
    end

    if capturingFarmKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            farmKeybind = input.KeyCode
            if farmKeybindBtn then
                farmKeybindBtn.Text = tostring(farmKeybind.Name) .. " (Keybind Farm)"
                farmKeybindBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 160)
            end
            capturingFarmKeybind = false
        end
        return
    end

    if not gameProcessed then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == walkspeedKeybind then
                toggleWalkSpeed()
                refreshWsToggleUI()
            elseif input.KeyCode == noclipKeybind then
                toggleNoclip()
                refreshNoclipToggleUI()
            elseif input.KeyCode == flyKeybind then
                toggleFly()
                refreshFlyToggleUI()
            elseif input.KeyCode == farmKeybind then
                toggleFarm()
                refreshFarmToggleUI()
            end
        end
    end

    if flyEnabled then
        if input.KeyCode == Enum.KeyCode.W then keysHeld.W = true
        elseif input.KeyCode == Enum.KeyCode.A then keysHeld.A = true
        elseif input.KeyCode == Enum.KeyCode.S then keysHeld.S = true
        elseif input.KeyCode == Enum.KeyCode.D then keysHeld.D = true
        elseif input.KeyCode == Enum.KeyCode.Space then keysHeld.Up = true
        elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then keysHeld.Down = true
        end
    end
end)

