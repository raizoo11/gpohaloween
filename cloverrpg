-- ESP: TRINKET SPAWNS (workspace.TrinketSpawns)
----------------------------------------------------------------
local trinketEspEnabled = true
local TRINKET_COLOR = Color3.fromRGB(255, 215, 0)
local trinketObjects = {}

local function removeTrinketESP(inst)
    local data = trinketObjects[inst]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        if data.conn then data.conn:Disconnect() end
        trinketObjects[inst] = nil
    end
end

local function applyTrinketESP(inst)
    if trinketObjects[inst] then return end

    local part = inst:IsA("BasePart") and inst or inst:FindFirstChildWhichIsA("BasePart")
    if not part then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = TRINKET_COLOR
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0
    highlight.Parent = inst

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 180, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = part
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = TRINKET_COLOR
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = inst.Name
    label.Parent = billboard

    local conn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and part.Parent then
            local dist = (char.HumanoidRootPart.Position - part.Position).Magnitude
            label.Text = string.format("%s [%dm]", inst.Name, math.floor(dist))
        end
    end)

    trinketObjects[inst] = { highlight = highlight, billboard = billboard, conn = conn }
end

local function scanTrinketSpawns()
    local folder = workspace:FindFirstChild("TrinketSpawns")
    if not folder then return end
    if trinketEspEnabled then
        for _, child in ipairs(folder:GetChildren()) do
            applyTrinketESP(child)
        end
    end
end

local trinketFolder = workspace:FindFirstChild("TrinketSpawns")
if trinketFolder then
    trinketFolder.ChildAdded:Connect(function(child)
        if trinketEspEnabled then
            task.wait(0.1)
            applyTrinketESP(child)
        end
    end)
    trinketFolder.ChildRemoved:Connect(function(child)
        removeTrinketESP(child)
    end)
end

task.spawn(function()
    task.wait(1)
    scanTrinketSpawns()
end)

local function toggleTrinketESP()
    trinketEspEnabled = not trinketEspEnabled
    if trinketEspEnabled then
        scanTrinketSpawns()
    else
        for inst, _ in pairs(trinketObjects) do
            removeTrinketESP(inst)
        end
    end
end

