local playerEspEnabled = true
local PLAYER_COLOR = Color3.fromRGB(0, 255, 100)
local playerObjects = {}

local function removePlayerESP(plr)
    local data = playerObjects[plr]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        if data.conn then data.conn:Disconnect() end
        playerObjects[plr] = nil
    end
end

local function applyPlayerESP(plr)
    if plr == LocalPlayer then return end
    if not plr.Character then return end
    if playerObjects[plr] then return end

    local char = plr.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = PLAYER_COLOR
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 160, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = root
    billboard.Parent = root

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = PLAYER_COLOR
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Text = plr.Name
    nameLabel.Parent = billboard

    local hpBarBg = Instance.new("Frame")
    hpBarBg.Size = UDim2.new(1, 0, 0, 8)
    hpBarBg.Position = UDim2.new(0, 0, 0, 22)
    hpBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    hpBarBg.BorderSizePixel = 0
    hpBarBg.Parent = billboard

    local hpBarFill = Instance.new("Frame")
    hpBarFill.Size = UDim2.new(1, 0, 1, 0)
    hpBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    hpBarFill.BorderSizePixel = 0
    hpBarFill.Parent = hpBarBg

    local hpLabel = Instance.new("TextLabel")
    hpLabel.Size = UDim2.new(1, 0, 0, 14)
    hpLabel.Position = UDim2.new(0, 0, 0, 32)
    hpLabel.BackgroundTransparency = 1
    hpLabel.TextColor3 = Color3.new(1, 1, 1)
    hpLabel.TextStrokeTransparency = 0
    hpLabel.TextScaled = true
    hpLabel.Font = Enum.Font.Gotham
    hpLabel.Text = string.format("%d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
    hpLabel.Parent = billboard

    local conn = RunService.Heartbeat:Connect(function()
        if not root.Parent or not hum.Parent then return end

        local hpAlpha = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        hpBarFill.Size = UDim2.new(hpAlpha, 0, 1, 0)
        hpBarFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpAlpha), 255 * hpAlpha, 0)
        hpLabel.Text = string.format("%d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))

        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local dist = (myChar.HumanoidRootPart.Position - root.Position).Magnitude
            nameLabel.Text = string.format("%s [%dm]", plr.Name, math.floor(dist))
        end
    end)

    playerObjects[plr] = { highlight = highlight, billboard = billboard, conn = conn }
end

local function refreshAllPlayerESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if playerEspEnabled then
            applyPlayerESP(plr)
        else
            removePlayerESP(plr)
        end
    end
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        removePlayerESP(plr)
        task.wait(0.5)
        if playerEspEnabled then applyPlayerESP(plr) end
    end)
end)

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        plr.CharacterAdded:Connect(function()
            removePlayerESP(plr)
            task.wait(0.5)
            if playerEspEnabled then applyPlayerESP(plr) end
        end)
    end
end

Players.PlayerRemoving:Connect(function(plr)
    removePlayerESP(plr)
end)

task.spawn(function()
    while true do
        if playerEspEnabled then
            refreshAllPlayerESP()
        end
        task.wait(2)
    end
end)

local function togglePlayerESP()
    playerEspEnabled = not playerEspEnabled
    if playerEspEnabled then
        refreshAllPlayerESP()
    else
        for plr, _ in pairs(playerObjects) do
            removePlayerESP(plr)
        end
    end
end

